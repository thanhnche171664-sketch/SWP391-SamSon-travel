<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="800" height="400">
  <defs>
    <linearGradient id="beachGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#98D8E8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#B0E0E6;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="sandGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F4E4BC;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E6D3A3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="800" height="300" fill="url(#beachGradient)"/>
  
  <!-- Sun -->
  <circle cx="650" cy="80" r="40" fill="#FFD700" opacity="0.8"/>
  
  <!-- Clouds -->
  <ellipse cx="150" cy="60" rx="30" ry="20" fill="white" opacity="0.7"/>
  <ellipse cx="170" cy="60" rx="25" ry="15" fill="white" opacity="0.7"/>
  <ellipse cx="300" cy="40" rx="35" ry="22" fill="white" opacity="0.7"/>
  <ellipse cx="320" cy="40" rx="28" ry="18" fill="white" opacity="0.7"/>
  
  <!-- Sea -->
  <rect width="800" height="100" y="300" fill="#4682B4"/>
  
  <!-- Waves -->
  <path d="M0 300 Q100 280 200 300 T400 300 T600 300 T800 300 L800 400 L0 400 Z" fill="#5F9EA0"/>
  <path d="M0 320 Q150 300 300 320 T600 320 T800 320 L800 400 L0 400 Z" fill="#87CEEB" opacity="0.6"/>
  
  <!-- Beach -->
  <rect width="800" height="50" y="350" fill="url(#sandGradient)"/>
  
  <!-- Palm trees -->
  <line x1="100" y1="350" x2="100" y2="280" stroke="#8B4513" stroke-width="8"/>
  <path d="M100 280 Q80 260 90 240 Q100 220 110 240 Q120 260 100 280" fill="#228B22"/>
  <path d="M100 280 Q70 270 80 250 Q100 230 120 250 Q130 270 100 280" fill="#228B22"/>
  
  <line x1="700" y1="350" x2="700" y2="280" stroke="#8B4513" stroke-width="8"/>
  <path d="M700 280 Q680 260 690 240 Q700 220 710 240 Q720 260 700 280" fill="#228B22"/>
  <path d="M700 280 Q670 270 680 250 Q700 230 720 250 Q730 270 700 280" fill="#228B22"/>
  
  <!-- Text -->
  <text x="400" y="200" font-family="Arial, sans-serif" font-size="48" font-weight="bold" text-anchor="middle" fill="white" opacity="0.9">Sầm Sơn Beach</text>
  <text x="400" y="240" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="white" opacity="0.8">Beautiful Beach Destination</text>
</svg>
