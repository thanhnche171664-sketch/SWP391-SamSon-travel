<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="800" height="400">
  <defs>
    <linearGradient id="islandGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4682B4;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="mountainGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#228B22;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#006400;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Sky -->
  <rect width="800" height="400" fill="url(#islandGradient)"/>
  
  <!-- Sun -->
  <circle cx="650" cy="80" r="35" fill="#FFD700" opacity="0.9"/>
  
  <!-- Island silhouette -->
  <path d="M100 400 Q200 200 300 150 Q400 100 500 120 Q600 140 700 200 Q750 250 800 400 L100 400 Z" fill="url(#mountainGradient)"/>
  
  <!-- Mountain peaks -->
  <path d="M200 200 Q220 180 240 200 Q260 220 280 200 Q300 180 320 200" fill="#2F4F2F" opacity="0.8"/>
  <path d="M400 150 Q420 130 440 150 Q460 170 480 150 Q500 130 520 150" fill="#2F4F2F" opacity="0.8"/>
  
  <!-- Water -->
  <rect width="800" height="100" y="300" fill="#4682B4"/>
  
  <!-- Waves -->
  <path d="M0 300 Q100 280 200 300 T400 300 T600 300 T800 300 L800 400 L0 400 Z" fill="#5F9EA0"/>
  
  <!-- Text -->
  <text x="400" y="200" font-family="Arial, sans-serif" font-size="48" font-weight="bold" text-anchor="middle" fill="white" opacity="0.9">Đảo Hòn Mê</text>
  <text x="400" y="240" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="white" opacity="0.8">Wild Island Adventure</text>
</svg>
